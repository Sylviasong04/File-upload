# Supabase Project URL (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (server-side only, do not expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name used by this app (must exist in Supabase Storage)
SUPABASE_STORAGE_BUCKET=documents

# AI summary (optional; required only for /api/files/:id/summary)
# If you use WolfAI or other OpenAI-compatible providers, set BASE URL + MODEL.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://wolfai.top/v1
OPENAI_MODEL=deepseek-r1
